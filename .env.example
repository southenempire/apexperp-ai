# Wallet that holds the dreamDEX perps margin account (Somnia Tokyo testnet only).
PRIVATE_KEY=0x...

# Sentinel thresholds: health = equity / maintenance margin (1.0 = liquidation)
REDUCE_BELOW_HEALTH=1.5
FLATTEN_BELOW_HEALTH=1.15
REDUCE_PERCENTAGE=25
MAX_SLIPPAGE=0.02
POLL_INTERVAL_MS=1000
COOLDOWN_MS=5000

# 1 = log decisions without sending transactions
DRY_RUN=0

